# ---- P12 API / dashboard ---------------------------------------------------
# Copy to .env and adjust. .env is git-ignored; never commit real secrets.

# Signing key for access/refresh tokens. If unset the API generates an
# ephemeral one per process, which invalidates every token on restart.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM=HS256

# Token lifetimes (seconds). Access is deliberately short-lived.
ACCESS_TOKEN_TTL_S=900
REFRESH_TOKEN_TTL_S=604800

# Where uvicorn binds. Keep 127.0.0.1 unless you put auth in front of it.
HOST=127.0.0.1
PORT=8000

# Comma-separated allowed origins for the React dev server.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- storage ---------------------------------------------------------------
# Local SQLite is the source of truth (created on first run).
SQLITE_PATH=data/sdn.db

# Optional MongoDB mirror for the event stream. Leave blank to run SQLite-only.
# When set, the API pings it once at startup and degrades gracefully if it is
# unreachable -- Mongo is never a hard dependency.
MONGO_URL=
MONGO_DB=sdn

# ---- project data sources --------------------------------------------------
CONFIG_PATH=config.yaml
PORT_MAP_PATH=data/portmap.json
EVENTS_PATH=data/logs/events.jsonl
# ---- Agentic AI / OpenRouter + Groq (free tiers) ---------------------------
# OpenRouter: free models use the `:free` suffix (see /api/agent/config).
OPENROUTER_API_KEY=
# Groq: fast OpenAI-compatible inference; free tier ~1,000 req/day per model.
GROQ_API_KEY=
